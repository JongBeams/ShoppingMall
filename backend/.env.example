# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_PORT=8000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# CORS Configuration
NEXT_PUBLIC_URL=http://localhost:3000

# AI Models Configuration
OLLAMA_HOST=http://localhost:11435
OLLAMA_MODEL=qwen2.5:14b
EMBEDDING_MODEL=BAAI/bge-m3
OLLAMA_TIMEOUT=120

# Recommendation System Settings
RECOMMENDATION_ANALYSIS_MONTHS=6
RECOMMENDATION_MIN_REVIEWS=3
RECOMMENDATION_PRICE_TOLERANCE=0.3
RECOMMENDATION_DEFAULT_LIMIT=50
RECOMMENDATION_EXCLUDE_PURCHASED=true

# Search Settings
SEARCH_DOCUMENT_LIMIT=3
SEARCH_PRODUCT_LIMIT=50
SEARCH_MIN_KEYWORD_LENGTH=2

# Toss Payments Configuration
TOSS_SECRET_KEY=test_sk_your_secret_key_here
TOSS_CLIENT_KEY=test_ck_your_client_key_here

# Security Configuration
ENVIRONMENT=development  # production | development
CSRF_ENABLED=false  # CSRF 보호 활성화 (프로덕션=true, 개발=false)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001  # CORS 허용 도메인 (쉼표로 구분)

# JWT Configuration (Advanced)
REFRESH_TOKEN_EXPIRE_DAYS=7  # Refresh Token 만료 기간 (일)

# Monitoring (Optional)
SENTRY_DSN=  # Sentry DSN (프로덕션 에러 추적)